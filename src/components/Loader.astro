---
// Écran d'accueil « Le mur » : un mur de briques se monte, l'enseigne glisse dessus et se dessine.
import Logo from "./Logo.astro";
import { loader } from "../content/site";
---

<div id="loader" class="loader" data-loader>
	<canvas class="loader-wall" data-wall aria-hidden="true"></canvas>
	<div class="loader-shade" data-shade aria-hidden="true"></div>
	<div class="loader-sign" data-loader-sign aria-hidden="true">
		<Logo variant="enseigne" decorative />
	</div>
	<p class="sr-only" role="status">{loader.status}</p>
	<button type="button" class="loader-skip" data-loader-skip>{loader.skip}</button>
</div>

<style>
	.loader {
		position: fixed;
		inset: 0;
		z-index: 90;
		display: none;
		background: var(--color-ink);
	}
	:global(html.js:not(.intro-seen)) .loader {
		display: block;
	}
	.loader-wall {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.loader-shade {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(120% 90% at 50% 45%, transparent 35%, rgb(8 8 9 / 0.55) 100%),
			linear-gradient(180deg, rgb(8 8 9 / 0.35), transparent 30%);
	}
	.loader-sign {
		position: absolute;
		inset: 0;
		margin: auto;
		width: min(88vw, 1100px);
		height: fit-content;
		visibility: hidden;
		filter: drop-shadow(0 22px 40px rgb(0 0 0 / 0.6));
	}
	.loader-sign :global(svg) {
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.loader-skip {
		position: absolute;
		right: 16px;
		bottom: calc(16px + env(safe-area-inset-bottom));
		padding: 0.7rem 1rem;
		font-family: var(--font-label);
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-paper) 80%, transparent);
		background: rgb(12 13 15 / 0.55);
		border: 1px solid rgb(255 255 255 / 0.18);
		border-radius: 2px;
		cursor: pointer;
	}
	/* Sous 1024 px, la barre Appeler / Itinéraire (10 px + 48 px + marge basse) passe devant : le bouton se place au-dessus */
	@media (max-width: 1023.98px) {
		.loader-skip {
			bottom: calc(70px + max(10px, env(safe-area-inset-bottom)));
		}
	}
	.loader-skip:hover {
		color: var(--color-gold);
		border-color: var(--color-gold);
	}
</style>
