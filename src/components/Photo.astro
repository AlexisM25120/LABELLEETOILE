---
// Photo optimisée (AVIF/WebP, srcset) sans dépasser la taille d'origine.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { widthsFor } from "../lib/photos";

interface Props {
	src: ImageMetadata;
	alt: string;
	sizes: string;
	widths?: number[];
	class?: string;
	loading?: "lazy" | "eager";
	draggable?: boolean;
}
const { src, alt, sizes, widths = [400, 640, 960, 1280], class: className, loading = "lazy", draggable } = Astro.props;
---

<Picture
	src={src}
	alt={alt}
	formats={["avif", "webp"]}
	widths={widthsFor(src, widths)}
	sizes={sizes}
	loading={loading}
	decoding="async"
	class={className}
	draggable={draggable === false ? "false" : undefined}
/>
