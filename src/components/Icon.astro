---
// Petites icônes d'interface (24×24, trait). Les icônes des prestations sont dans ServiceIcon.astro.
interface Props {
	name: "phone" | "route" | "arrow" | "facebook" | "mail" | "clock" | "pin" | "star" | "plus" | "drag" | "quote" | "up" | "close" | "left" | "images";
	class?: string;
}
const { name, class: className = "" } = Astro.props;
const paths: Record<Props["name"], string> = {
	phone: '<path d="M5.2 3.5h3l1.6 4.3-2 1.3a11 11 0 0 0 5.1 5.1l1.3-2 4.3 1.6v3a2 2 0 0 1-2.2 2C10 18.3 5.7 14 4.7 7.7a2 2 0 0 1 .5-1.6c.1-1.4 0-2.6 0-2.6z"/>',
	route: '<path d="M3.5 11 20.5 3.5 13 20.5l-2-7.5z"/>',
	arrow: '<path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5"/>',
	facebook: '<path d="M14 21v-7.5h2.6l.4-3H14V8.6c0-.9.3-1.5 1.6-1.5H17V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.8 1.4-3.8 3.9v2.3H8.5v3H11V21"/>',
	mail: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
	pin: '<path d="M12 21s6.5-5.6 6.5-11a6.5 6.5 0 0 0-13 0c0 5.4 6.5 11 6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
	star: '<path d="m12 3.2 2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z" fill="currentColor" stroke="none"/>',
	plus: '<path d="M12 5v14M5 12h14"/>',
	drag: '<path d="M9 7 4 12l5 5M15 7l5 5-5 5"/>',
	quote: '<path d="M10 7c-3.3.8-5 3.2-5 7v3h5v-5H7.4c.2-1.9 1.1-3 2.6-3.5zM19 7c-3.3.8-5 3.2-5 7v3h5v-5h-2.6c.2-1.9 1.1-3 2.6-3.5z" fill="currentColor" stroke="none"/>',
	up: '<path d="M12 19V5M6.5 10.5 12 5l5.5 5.5"/>',
	close: '<path d="M6 6l12 12M18 6 6 18"/>',
	left: '<path d="M20 12H5M10.5 6.5 5 12l5.5 5.5"/>',
