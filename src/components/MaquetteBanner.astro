---
import { banner } from "../content/site";
---

<div class="maquette-banner" role="note">
	<span class="dot" aria-hidden="true"></span>
	<span class="hidden md:inline">{banner.full}</span>
	<span class="md:hidden">{banner.short}</span>
</div>

<style>
	.maquette-banner {
		position: fixed;
		inset: 0 0 auto;
		z-index: 95;
		height: var(--banner-h);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0 1rem;
		background: #0a0a0b;
		border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent);
		color: var(--color-gold);
		font-family: var(--font-label);
		font-weight: 600;
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		white-space: nowrap;
		overflow: hidden;
	}
	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-gold);
		flex: none;
		animation: blink 2.4s ease-in-out infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0.25;
		}
	}
	:global(:root) {
		--banner-h: 24px;
	}
	@media (min-width: 768px) {
		:global(:root) {
			--banner-h: 26px;
		}
		.maquette-banner {
			font-size: 0.72rem;
		}
	}
</style>
