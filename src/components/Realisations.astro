---
// « Ça sort de l'atelier » : galerie horizontale épinglée (tablette et ordinateur),
// carrousel au doigt sur mobile. Une carte avant / après (deux paires), puis un projet par carte.
// Toucher une carte ouvre la visionneuse du projet (Viewer.astro).
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import Viewer from "./Viewer.astro";
import { realisations as R } from "../content/site";
import { byId, fullName, inSection, monthLabel, photoByFile } from "../lib/realisations";
import { fr } from "../lib/typo";

const pairIds = new Set(R.beforeAfter.pairs.map((p) => p.project));
const galleryProjects = inSection("galerie");
const cards = galleryProjects
	.filter((p) => !pairIds.has(p.id))
	.map((p, i) => ({ project: p, cover: photoByFile(p.photos[0].file), index: String(i + 2).padStart(2, "0") }));
const pairs = R.beforeAfter.pairs.map((p) => {
	const project = byId(p.project);
	return {
		...p,
		project,
		before: photoByFile(p.before),
		after: photoByFile(p.after),
		beforeIndex: project.photos.findIndex((x) => x.file === p.before),
		afterIndex: project.photos.findIndex((x) => x.file === p.after),
	};
});
const cardSizes = "(max-width: 767px) 78vw, 30vw";
const halfSizes = "(max-width: 767px) 46vw, 24vw";
const count = (n: number) => `${n} ${R.photosLabel}`;
---

<section id="realisations" class="gal" data-trace data-trace-side="right" data-gallery aria-label={fr(R.title)}>
	<div class="gal-pin" data-gal-pin>
		<!-- En-tête mobile -->
		<div class="wrap over gal-head md:hidden">
			<p class="label label-line">{R.label}</p>
			<h2 class="h-section mt-4">{fr(R.title)}</h2>
			<p class="gal-intro">{fr(R.intro)}</p>
		</div>

		<div class="gal-viewport over" data-gal-viewport>
			<ol class="gal-track no-scrollbar" data-gal-track>
				<!-- En-tête intégré à la bande (tablette et ordinateur) -->
				<li class="gal-title-panel hidden md:flex">
					<p class="label label-line">{R.label}</p>
					<h2 class="h-section mt-5">{fr(R.title)}</h2>
					<p class="gal-intro">{fr(R.intro)}</p>
					<p class="gal-scroll-hint" aria-hidden="true">
						<Icon name="arrow" class="size-5" />
						{R.scrollHint}
					</p>
				</li>

				<!-- 01 · Avant / après, deux paires au choix -->
				<li class="card card-pair" data-pair>
					<div class="pair-tabs" role="tablist" aria-label={R.beforeAfter.label}>
						{
							pairs.map((p, i) => (
								<button type="button" role="tab" id={`pair-tab-${i}`} aria-controls={`pair-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class="pair-tab" data-pair-tab={i}>
									{p.tab}
								</button>
							))
						}
					</div>
					{
						pairs.map((p, i) => (
							<div class="pair" id={`pair-${i}`} role="tabpanel" aria-labelledby={`pair-tab-${i}`} hidden={i !== 0} data-pair-panel={i}>
								<div class="media pair-media">
									<figure class="half">
										<Photo src={p.before.img} alt={fr(p.before.alt)} sizes={halfSizes} widths={[320, 480, 720]} position={p.before.focus} />
										<span class="ba-tag">{R.before}</span>
										<button type="button" class="hit" data-open-project={p.project.id} data-start={p.beforeIndex} aria-haspopup="dialog" aria-label={`${R.openLabel} : ${fr(fullName(p.project))}, ${R.before.toLowerCase()} (${count(p.project.photos.length)})`} />
									</figure>
									<figure class="half">
										<Photo src={p.after.img} alt={fr(p.after.alt)} sizes={halfSizes} widths={[320, 480, 720]} position={p.after.focus} />
										<span class="ba-tag ba-tag-after">{R.after}</span>
										<button type="button" class="hit" data-open-project={p.project.id} data-start={p.afterIndex} aria-haspopup="dialog" aria-label={`${R.openLabel} : ${fr(fullName(p.project))}, ${R.after.toLowerCase()} (${count(p.project.photos.length)})`} />
									</figure>
								</div>
								<div class="meta">
									<p class="label meta-top">
										<span>01</span>
										<span>{monthLabel(p.project.date)}</span>
									</p>
									<h3 class="model display">
										{fr(p.project.model)} {p.project.detail && <span class="detail">{fr(p.project.detail)}</span>}
									</h3>
									<p class="work">{fr(p.caption.split(" · ").pop()!.replace(/^./, (c) => c.toUpperCase()))}</p>
								</div>
							</div>
						))
					}
				</li>

				{
					cards.map(({ project: p, cover, index }) => (
						<li class="card">
							<div class="media">
								<Photo src={cover.img} alt={fr(cover.alt)} sizes={cardSizes} widths={[360, 540, 800]} position={cover.focus} class="card-img" />
								<span class="card-count" aria-hidden="true">
									<Icon name="images" class="size-4" />
									{p.photos.length}
								</span>
							</div>
							<div class="meta">
								<p class="label meta-top">
									<span>{index}</span>
									<span>{monthLabel(p.date)}</span>
								</p>
								<h3 class="model display">
									{fr(p.model)} {p.detail && <span class="detail">{fr(p.detail)}</span>}
								</h3>
								<p class="work">{fr(p.work)}</p>
							</div>
							<button type="button" class="hit" data-open-project={p.id} aria-haspopup="dialog" aria-label={`${R.openLabel} : ${fr(fullName(p))} (${count(p.photos.length)})`} />
						</li>
					))
				}
			</ol>
		</div>

		<div class="wrap over gal-foot">
			<div class="gal-progress" aria-hidden="true"><span data-gal-bar></span></div>
			<p class="gal-swipe md:hidden" aria-hidden="true">
				<Icon name="drag" class="size-4" />
				{R.swipeHint}
			</p>
		</div>
	</div>
	<Viewer projects={galleryProjects} />
</section>

<style>
	.gal {
		position: relative;
		background: var(--color-ink);
	}
	.gal-pin {
		position: relative;
		padding-block: 5rem 3rem;
		background: var(--color-ink);
	}
	.gal-intro {
		margin-top: 1rem;
		color: var(--color-mute);
		font-size: 1.05rem;
		max-width: 28rem;
	}
	.gal-track {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		margin-top: 2.25rem;
		padding-inline: 16px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: 16px;
		overscroll-behavior-x: contain;
		-webkit-overflow-scrolling: touch;
	}
	.card {
		position: relative;
		flex: none;
		width: min(78vw, 320px);
		scroll-snap-align: start;
		display: flex;
		flex-direction: column;
	}
	.media {
		position: relative;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: var(--color-panel);
		border-radius: 2px;
	}
	.media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.9s var(--ease-out-expo);
	}
	.card:hover .media :global(img),
	.half:hover :global(img) {
		transform: scale(1.04);
	}
	.card-count {
		position: absolute;
		right: 0.7rem;
		bottom: 0.7rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.55rem;
		font-family: var(--font-label);
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		color: var(--color-paper);
		background: rgb(12 13 15 / 0.72);
		border-radius: 2px;
		pointer-events: none;
	}
	/* Zone cliquable : toute la carte (ou la moitié de photo pour l'avant / après) */
	.hit {
		position: absolute;
		inset: 0;
		z-index: 2;
		cursor: zoom-in;
		background: transparent;
		border-radius: 2px;
	}
	.hit:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: 3px;
	}
	.meta {
		padding: 1rem 0.1rem 0;
	}
	.meta-top {
		display: flex;
		gap: 0.9rem;
		color: var(--color-gold);
	}
	.meta-top span + span {
		color: var(--color-mute);
	}
	.model {
		margin-top: 0.5rem;
		font-size: clamp(1.9rem, 8vw, 2.6rem);
		line-height: 0.95;
	}
	.detail {
		color: var(--color-gold);
	}
	.work {
		margin-top: 0.5rem;
		color: color-mix(in srgb, var(--color-paper) 82%, transparent);
		font-size: 0.98rem;
		line-height: 1.45;
	}

	/* Avant / après côte à côte (deux photos 3:4) */
	.card-pair {
		width: min(92vw, 520px);
	}
	.pair-tabs {
		display: inline-flex;
		align-self: flex-start;
		margin-bottom: 0.75rem;
		padding: 3px;
		border: 1px solid var(--color-line);
		border-radius: 999px;
	}
	.pair-tab {
		min-height: 2.25rem;
		padding: 0.35rem 1rem;
		border-radius: 999px;
		font-family: var(--font-label);
		font-weight: 700;
		font-size: 0.9rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-mute);
		transition:
			background-color 0.25s,
			color 0.25s;
		cursor: pointer;
	}
	.pair-tab[aria-selected="true"] {
		background: var(--color-gold);
		color: var(--color-ink);
	}
	.pair {
		display: flex;
		flex-direction: column;
	}
	.pair[hidden] {
		display: none;
	}
	.pair-media {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
		/* mobile : un peu plus haut que deux 3:4 côte à côte, pour s'aligner sur les autres cartes */
		aspect-ratio: 6 / 5;
		background: transparent;
	}
	.half {
		position: relative;
		margin: 0;
		overflow: hidden;
		background: var(--color-panel);
	}
	.ba-tag {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		z-index: 1;
		padding: 0.3rem 0.55rem;
		font-family: var(--font-label);
		font-weight: 700;
		font-size: 0.78rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		background: rgb(12 13 15 / 0.75);
		color: var(--color-paper);
		pointer-events: none;
	}
	.ba-tag-after {
		color: var(--color-gold);
	}

	.gal-foot {
		margin-top: 1.75rem;
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.gal-progress {
		position: relative;
		flex: 1;
		height: 2px;
		background: var(--color-line);
		overflow: hidden;
	}
	.gal-progress span {
		position: absolute;
		inset: 0;
		background: var(--color-gold);
		transform-origin: 0 50%;
		transform: scaleX(0.08);
	}
	.gal-swipe {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-label);
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-mute);
	}

	/* Tablette et ordinateur : la bande défile horizontalement, la section reste en place */
	@media (min-width: 768px) {
		.gal {
			--mh: min(56svh, 580px);
		}
		.gal-pin {
			position: sticky;
			top: 0;
			height: 100vh;
			height: 100svh;
			padding: calc(var(--banner-h) + 72px) 0 0;
			display: flex;
			flex-direction: column;
			justify-content: center;
			overflow: hidden;
			z-index: 3;
		}
		.gal-viewport {
			overflow: visible;
		}
		.gal-track {
			margin-top: 0;
			overflow: visible;
			scroll-snap-type: none;
			gap: 28px;
			padding-inline: 64px;
			align-items: flex-end;
			will-change: transform;
		}
		.gal-title-panel {
			flex: none;
			width: min(34rem, 44vw);
			flex-direction: column;
			justify-content: flex-end;
			padding-right: 2rem;
			padding-bottom: 7.5rem;
		}
		.gal-scroll-hint {
			margin-top: 2rem;
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			font-family: var(--font-label);
			font-weight: 600;
			font-size: 0.85rem;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			color: var(--color-gold);
		}
		.card {
			width: calc(var(--mh) * 0.75);
		}
		.media {
			height: var(--mh);
			aspect-ratio: auto;
		}
		.card-pair {
			width: calc(var(--mh) * 1.5 + 4px);
		}
		.pair-media {
			height: calc(var(--mh) - 3rem);
			aspect-ratio: auto;
		}
		.model {
			font-size: clamp(1.8rem, 2.6vw, 2.6rem);
		}
		.gal-foot {
			margin-top: 2rem;
			margin-bottom: 2.5rem;
		}
		.gal-swipe {
			display: none;
		}
	}
	@media (min-width: 1024px) {
		.gal-track {
			padding-inline: 120px;
		}
	}
	@media (min-width: 1320px) {
		.gal-track {
			padding-left: calc((100vw - 1320px) / 2 + 120px);
		}
	}
	@media (min-width: 768px) and (prefers-reduced-motion: reduce) {
		.gal-pin {
			position: relative;
			height: auto;
		}
		.gal-track {
			overflow-x: auto;
			padding-bottom: 1rem;
		}
	}
</style>
