---
import Icon from "./Icon.astro";
import { contact, mobileBar } from "../content/site";
---

<div class="mobile-bar lg:hidden" data-mobile-bar>
	<div class="grid grid-cols-[1.25fr_1fr] gap-2.5 px-4 pt-2.5">
		<a href={contact.phoneHref} class="btn btn-gold min-h-12 w-full">
			<Icon name="phone" />
			{mobileBar.call}
		</a>
		<a href={contact.directionsUrl} class="btn btn-line min-h-12 w-full" target="_blank" rel="noopener">
			<Icon name="route" />
			{mobileBar.directions}
		</a>
	</div>
</div>

<style>
	/* La barre fixe ne masque jamais la fin de la page (hauteur : 10 px + bouton 48 px + 10 px) */
	@media (max-width: 1023.98px) {
		:global(body) {
			padding-bottom: calc(68px + env(safe-area-inset-bottom));
		}
	}
	.mobile-bar {
		position: fixed;
		inset: auto 0 0;
		z-index: 72;
		padding-bottom: max(10px, env(safe-area-inset-bottom));
		background: linear-gradient(to top, color-mix(in srgb, var(--color-deep) 96%, transparent) 55%, transparent);
		transform: translateY(110%);
		transition: transform 0.5s var(--ease-out-expo);
	}
	:global(.mobile-bar.is-on) {
		transform: none;
	}
	:global(html.no-js) .mobile-bar {
		transform: none;
	}
	/* Très petits écrans (moins de 360 px) : deux boutons égaux et plus serrés, sinon « Itinéraire » sort de l'écran */
	@media (max-width: 359.98px) {
		.mobile-bar > div {
			grid-template-columns: 1fr 1fr;
			gap: 8px;
		}
		.mobile-bar .btn {
			gap: 0.45rem;
			padding-inline: 0.6rem;
			font-size: 0.95rem;
			letter-spacing: 0.08em;
		}
	}
</style>
