---
import Photo from "./Photo.astro";
import ServiceIcon from "./ServiceIcon.astro";
import Logo from "./Logo.astro";
import { atelier as A } from "../content/site";
import { photoByFile } from "../lib/realisations";
import { fr } from "../lib/typo";

const pics = A.photos.map((f) => photoByFile(f));
---

<section class="atelier" data-trace aria-labelledby="atelier-title">
	<div class="wrap over">
		<p class="label label-line">{A.label}</p>
		<h2 id="atelier-title" class="h-section mt-4 max-w-[14ch]">{fr(A.title)}</h2>

		<div class="grid-a">
			{
				pics.map((p, i) => (
					<figure class:list={["pic", `pic-${i}`]} data-fade>
						<Photo src={p.img} alt={fr(p.alt)} sizes="(max-width: 767px) 46vw, 24vw" widths={[360, 540, 800]} position={p.focus} />
						{i === 0 && <span class="corner tl" />}
						{i === pics.length - 1 && <span class="corner br" />}
						<figcaption class="pic-cap">{fr(p.caption)}</figcaption>
					</figure>
				))
			}
			<div class="portrait" data-fade role="img" aria-label={`${A.portraitTitle} : ${fr(A.portraitText)}`}>
				<Logo variant="symbole" class="portrait-mark" decorative />
				<p class="label">{A.portraitTitle}</p>
				<p class="portrait-text">{fr(A.portraitText)}</p>
			</div>
			<div class="body" data-fade>
				<p class="text">{fr(A.text)}</p>
				<h3 class="label mt-10">{A.equipmentTitle}</h3>
				<ul class="equip">
					{
						A.equipment.map((e) => (
							<li>
								<ServiceIcon name={e.icon} class="equip-icon" />
								<div>
									<p class="equip-title">{fr(e.title)}</p>
									<p class="equip-text">{fr(e.text)}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.atelier {
		position: relative;
		padding-block: 6rem;
	}
	@media (min-width: 1024px) {
		.atelier {
			padding-block: 9rem;
		}
	}
	.grid-a {
		margin-top: 3rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}
	.body {
		grid-column: 1 / -1;
	}
	@media (min-width: 768px) {
		.grid-a {
			grid-template-columns: repeat(4, 1fr);
			gap: 18px;
		}
		.pic-1 {
			margin-top: 3rem;
		}
		.portrait {
			margin-top: 1.5rem;
		}
	}
	@media (min-width: 1024px) {
		.body {
			grid-column: 1 / span 3;
			margin-top: 2rem;
		}
	}
	.pic {
		position: relative;
		margin: 0;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-radius: 2px;
		background: var(--color-panel);
	}
	.pic :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.pic-cap {
		position: absolute;
		inset: auto 0 0;
		padding: 2rem 0.75rem 0.65rem;
		font-family: var(--font-label);
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		background: linear-gradient(0deg, rgb(10 11 13 / 0.85), transparent);
	}
	.corner {
		position: absolute;
		width: 2.5rem;
		height: 2.5rem;
		border-color: var(--color-gold);
		border-style: solid;
	}
	.tl {
		top: 0.9rem;
		left: 0.9rem;
		border-width: 2px 0 0 2px;
	}
	.br {
		right: 0.9rem;
		bottom: 0.9rem;
		border-width: 0 2px 2px 0;
	}
	.portrait {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.4rem;
		aspect-ratio: 3 / 4;
		padding: 1.5rem;
		background:
			repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 10px, transparent 10px 20px),
			var(--color-panel);
		border: 1px dashed color-mix(in srgb, var(--color-gold) 45%, transparent);
		border-radius: 2px;
	}
	.portrait :global(.portrait-mark) {
		position: absolute;
		top: 1.5rem;
		left: 1.5rem;
		width: 3.5rem;
		height: auto;
		opacity: 0.6;
	}
	.portrait-text {
		color: var(--color-mute);
	}
	.text {
		font-size: clamp(1.25rem, 2.4vw, 1.75rem);
		line-height: 1.45;
		text-wrap: pretty;
		margin-top: 1.5rem;
	}
	.equip {
		margin-top: 1.25rem;
		display: grid;
		gap: 1.25rem;
	}
	@media (min-width: 768px) {
		.equip {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.equip li {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-line);
	}
	.equip :global(.equip-icon) {
		flex: none;
		width: 2.5rem;
		height: 2.5rem;
		color: var(--color-gold);
	}
	.equip-title {
		font-family: var(--font-label);
		font-weight: 700;
		font-size: 1.2rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.equip-text {
		margin-top: 0.2rem;
		color: var(--color-mute);
		font-size: 0.95rem;
	}
</style>
