---
import Layout from "../layouts/Layout.astro";
import Logo from "./Logo.astro";
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import { legal, contact } from "../content/site";
import { fr } from "../lib/typo";

interface Props {
	page: { title: string; sections: { title: string; lines: string[] }[] };
}
const { page } = Astro.props;
---

<Layout title={`${page.title} · ${contact.name}`}>
	<header class="legal-head">
		<div class="wrap flex items-center justify-between gap-4">
			<a href="/" aria-label="Retour à l'accueil"><Logo variant="horizontal" class="h-10 w-auto md:h-12" decorative /></a>
			<a href="/" class="label inline-flex items-center gap-2"><Icon name="arrow" class="size-4 rotate-180" />{legal.back}</a>
		</div>
	</header>
	<main id="contenu" class="wrap legal">
		<h1 class="h-section">{page.title}</h1>
		<p class="draft">{fr(legal.draft)}</p>
		{
			page.sections.map((s) => (
				<section>
					<h2 class="label">{s.title}</h2>
					{s.lines.map((l) =>
						/^https?:\/\//.test(l) ? (
							<p>
								<a href={l} class="link-gold">
									{l.replace(/^https?:\/\//, "")}
								</a>
							</p>
						) : (
							<p>{fr(l)}</p>
						),
					)}
				</section>
			))
		}
	</main>
	<Footer home={false} />
</Layout>

<style>
	.legal-head {
		padding-top: calc(var(--banner-h) + 1.25rem);
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--color-line);
	}
	.legal {
		padding-block: 4rem 6rem;
		max-width: 60rem;
	}
	.draft {
		margin-top: 1.25rem;
		padding: 0.75rem 1rem;
		border-left: 2px solid var(--color-gold);
		background: var(--color-panel);
		color: var(--color-mute);
	}
	section {
		margin-top: 2.75rem;
	}
	section p {
		margin-top: 0.5rem;
		color: color-mix(in srgb, var(--color-paper) 85%, transparent);
	}
	h2 {
		margin-bottom: 0.75rem;
	}
</style>
