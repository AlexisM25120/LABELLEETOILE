---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { nav, contact, actions } from "../content/site";
import { fr } from "../lib/typo";
---

<header class="site-header" data-header>
	<div class="wrap flex h-full items-center justify-between gap-6">
		<a href="#top" class="header-logo block shrink-0" data-header-logo aria-label="Carrosserie La Belle Étoile, retour en haut">
			<Logo variant="horizontal" class="h-9 w-auto md:h-11" decorative />
		</a>
		<nav class="hidden items-center gap-8 lg:flex" aria-label="Navigation principale">
			{
				nav.map((item) => (
					<a href={item.href} class="nav-link">
						{item.label}
					</a>
				))
			}
		</nav>
		<a href={contact.phoneHref} data-m="appel" class="btn btn-gold hidden min-h-11 rounded-full px-5 py-2.5 text-[0.95rem] md:inline-flex">
			<Icon name="phone" />
			{fr(contact.phone)}
		</a>
		<a href={contact.phoneHref} data-m="appel" class="call-round md:hidden" aria-label={fr(actions.callLong)}>
			<Icon name="phone" class="size-5" />
		</a>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset: var(--banner-h) 0 auto;
		z-index: 70;
		height: 60px;
		transition:
			background-color 0.35s,
			border-color 0.35s,
			transform 0.45s var(--ease-out-expo),
			opacity 0.45s;
		border-bottom: 1px solid transparent;
	}
	@media (min-width: 768px) {
		.site-header {
			height: 72px;
		}
	}
	:global(.site-header.is-solid) {
		background: color-mix(in srgb, var(--color-ink) 88%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-color: var(--color-line);
	}
	:global(.site-header.is-hidden) {
		transform: translateY(calc(-100% - var(--banner-h)));
	}
	:global(html.js.is-loading) .site-header {
		opacity: 0;
		pointer-events: none;
	}
	.header-logo {
		transition: opacity 0.4s;
	}
	:global(.site-header.logo-off) .header-logo {
		opacity: 0;
		pointer-events: none;
	}
	.nav-link {
		font-family: var(--font-label);
		font-weight: 600;
		font-size: 1rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-paper);
		opacity: 0.85;
		transition:
			color 0.2s,
			opacity 0.2s;
	}
	.nav-link:hover {
		color: var(--color-gold);
		opacity: 1;
	}
	.call-round {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--color-gold);
		color: var(--color-ink);
	}
	@media (min-width: 768px) {
		.call-round {
			display: none;
		}
	}
</style>
